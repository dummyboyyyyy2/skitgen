# Neon Postgres connection string (get from neon.tech project dashboard)
DATABASE_URL=postgres://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require

# Gemini API key (used by either generator when Gemini is selected)
# Get one from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
# Additional Gemini keys — traffic is split 2 keys per app (see lib/geminiKeys.js)
# so Solo and Couple aren't all sharing GEMINI_API_KEY's quota.
GEMINI_API_KEY_SOLO_2=your_second_solo_gemini_api_key_here
GEMINI_API_KEY_COUPLE_1=your_first_couple_gemini_api_key_here
GEMINI_API_KEY_COUPLE_2=your_second_couple_gemini_api_key_here

# Gemini model for quality-sensitive calls (script writing, DNA synthesis, etc.).
GEMINI_MODEL=gemini-2.5-flash

# Cheaper/faster Gemini model used for small, low-stakes calls (idea/tone suggestions).
# When Gemini is selected, both Solo and Couple use this lite/full split.
GEMINI_MODEL_LITE=gemini-2.5-flash-lite

# OpenRouter API key (used by both Solo and Couple for script generation and refinement)
# Get one from https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Scriptwriting model on OpenRouter. Change this value to test another model.
# Current free model: Google Gemma 4 31B Instruct.
OPENROUTER_MODEL=google/gemma-4-31b-it:free

# Optional. OpenRouter fallback model used only when Gemini fails on DNA-build
# calls (ideas/analyzeSample/synthesizeDNA/updateDNA/tone/vibe, both apps).
# These calls require reliable JSON output, so this is kept independent of
# OPENROUTER_MODEL / the script-refine picker, which optimizes for writing
# quality instead. Falls back to OPENROUTER_MODEL above if unset.
OPENROUTER_MODEL_DNA=google/gemma-4-31b-it:free

# Optional metadata sent to OpenRouter.
OPENROUTER_SITE_URL=
OPENROUTER_SITE_NAME=SkitGen

# Anthropic API key (only used by the legacy per-app provider toggle in
# app/api/settings/route.js and the legacy /api/couple/avoid-note route —
# the main Solo and Couple generation flows no longer route to Anthropic)
# Get one from https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Anthropic model used whenever a generator is set to Anthropic via the legacy toggle.
ANTHROPIC_MODEL=claude-sonnet-5
